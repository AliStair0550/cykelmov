---
import Layout from '../layouts/Layout.astro';
import StructuredData from '../components/StructuredData.astro';
import { site } from '../lib/site';

// FAQ til FAQPage-schema. Spørgsmålet om garanti afventer bekræftelse fra
// Mohammed og er derfor bevidst udeladt, indtil vi har et konkret svar.
const faq = [
  {
    q: 'Har I altid brugte cykler?',
    s: 'Ja, men udvalget skifter hver uge. Ring eller kom forbi og se, hvad vi har.',
  },
  {
    q: 'Kan jeg prøve cyklen først?',
    s: 'Ja. Tag den en tur på Nørrebrogade, inden du beslutter dig.',
  },
  {
    q: 'Køber I brugte cykler?',
    s: 'Ja, vi tager cykler i bytte når du køber, og vi giver en vurdering med det samme.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.s },
  })),
};

const adresseKort = site.adresse.gade.replace(', st. tv.', '');

// Galleri-billeder: ægte fotos af butikken og de brugte cykler.
const galleri = [
  { src: '/assets/brugt-1.jpg', alt: 'Cykelmovs butik på Nørrebrogade 74 med brugte cykler udenfor' },
  { src: '/assets/brugt-2.jpg', alt: 'Brugte cykler klar til salg hos Cykelmov' },
];
---

<Layout
  title="Brugte cykler i København"
  titelFuld="Brugte cykler København | Efterset og klar | Cykelmov"
  description="Brugte kvalitetscykler på Nørrebro. Gennemgået i eget værksted, klar til gaden. Priser fra 1500 kr. Kom forbi Nørrebrogade 74."
  ogBillede="/assets/brugt-cover.jpg"
  headerMoerk
>
  <StructuredData slot="head" data={faqSchema} />

  <section class="brugt-hero">
    <div class="wrap">
      <span class="eyebrow ingen-streg">Brugte cykler</span>
      <h1 class="display-l">Brugte cykler i København</h1>
    </div>
  </section>

  <section class="brugt-intro">
    <div class="wrap">
      <article class="rig-tekst">
        <p>
          Vi har altid brugte cykler i butikken på Nørrebrogade 74. Hver eneste er gennemgået i
          vores eget værksted, inden den kommer på gulvet. Du får en cykel, der er klar til gaden, til
          en pris der giver mening.
        </p>
      </article>
    </div>
  </section>

  <section class="brugt-pris-sektion">
    <div class="wrap">
      <div class="brugt-pris-grid reveal">
        <div class="brugt-pris-tekst rig-tekst">
          <h2>Hvad koster en brugt cykel hos os</h2>
          <p>Prisen afhænger af mærke, stand og alder. Som tommelfingerregel:</p>
          <p class="brugt-pris-linje">Brugte cykler, både herre- og damecykler, fra 1500 kr.</p>
          <p>
            Lageret skifter hver uge. Ring på <a href={`tel:${site.telefonE164}`}>{site.telefon}</a> og
            hør, hvad vi har hjemme lige nu, eller kom forbi.
          </p>
        </div>
        <div class="brugt-galleri">
          {
            galleri.map((b) => (
              <img src={b.src} alt={b.alt} loading="lazy" width="600" height="450" />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="brugt-tekst">
    <div class="wrap">
      <article class="rig-tekst">
        <h2>Sådan gør vi cyklerne klar</h2>
        <p>
          Ingen cykel kommer på gulvet uden en tur gennem værkstedet. Vi tjekker bremser, gear, dæk,
          kæde og lås. Det der er slidt, bliver skiftet. Du kan se, hvad der er lavet på den enkelte
          cykel.
        </p>

        <h2>Derfor brugt fra butik og ikke fra nettet</h2>
        <p>
          Du kan prøve cyklen, før du køber. Du taler med en mekaniker, ikke en sælger på en annonce.
          Og du har en butik at komme tilbage til, hvis noget driller. Det har du ikke på DBA.
        </p>

        <h2>Byt din gamle cykel</h2>
        <p>
          Skal du have en ny eller nyere cykel, tager vi gerne din gamle i bytte. Kom forbi med den,
          så giver vi dig en pris med det samme.
        </p>

        <h2>Ofte stillede spørgsmål</h2>
        <div class="faq">
          {
            faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <div class="svar">{f.s}</div>
              </details>
            ))
          }
        </div>
      </article>
    </div>
  </section>

  <!-- CTA nederst -->
  <section class="brugt-cta-sektion">
    <div class="wrap">
      <div class="brugt-cta reveal">
        <div class="brugt-cta-tekst">
          <h2>Kom forbi eller ring</h2>
          <p>
            Kom forbi {adresseKort} i {site.adresse.by} eller ring på
            <a href={`tel:${site.telefonE164}`}>{site.telefon}</a>. Vi finder en cykel, der passer til
            dig.
          </p>
          <div class="brugt-knapper">
            <a href={site.maps} class="btn btn-cobalt">Find vej <span class="pil">→</span></a>
            <a href={`tel:${site.telefonE164}`} class="btn btn-ghost">Ring {site.telefon}</a>
            <a href="/vaerksted/" class="btn btn-ghost">Se værkstedet</a>
          </div>
        </div>
        <div class="brugt-tider">
          <h3>Åbningstider</h3>
          <ul>
            {
              site.aabningstider.map((a) => (
                <li>
                  <span class="dag">{a.dage}</span>
                  <span class="tid">{a.tid}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Cover-hero med billede + mørk gradient, så teksten forbliver læsbar. */
    .brugt-hero {
      position: relative;
      color: var(--kridt);
      padding: 150px 0 90px;
      overflow: hidden;
      background:
        linear-gradient(90deg, rgba(16, 16, 20, 0.82), rgba(16, 16, 20, 0.4) 58%, rgba(16, 16, 20, 0.2)),
        url('/assets/brugt-cover.jpg') center 90% / cover no-repeat;
    }
    .brugt-hero .eyebrow {
      color: var(--signal);
    }
    .brugt-hero h1 {
      max-width: 18ch;
      margin-top: 14px;
    }
    @media (max-width: 700px) {
      .brugt-hero {
        padding: 120px 0 60px;
        background:
          linear-gradient(180deg, rgba(16, 16, 20, 0.55), rgba(16, 16, 20, 0.78)),
          url('/assets/brugt-cover.jpg') center 90% / cover no-repeat;
      }
    }

    /* Stramme afstande, saa der ikke opstaar store huller mellem teksterne. */
    .brugt-intro {
      padding: 44px 0 14px;
    }
    .brugt-pris-sektion {
      padding: 14px 0 30px;
    }
    .brugt-tekst {
      padding: 16px 0 68px;
    }
    /* Galleriet er en enkelt lav raekke, saa det ikke bliver hoejere end
       teksten og skaber et stort hul foer naeste afsnit. Lodret centreret. */
    .brugt-pris-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 40px;
      align-items: center;
    }
    .brugt-pris-tekst h2 {
      margin-top: 0;
    }
    .brugt-pris-tekst p:last-child {
      margin-bottom: 0;
    }
    .brugt-pris-linje {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 1.35rem;
      color: var(--cobalt, #1d3ee3);
    }
    .brugt-galleri {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .brugt-galleri img {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border: 1px solid var(--linje);
      border-radius: 10px;
    }
    @media (max-width: 820px) {
      .brugt-pris-grid {
        grid-template-columns: 1fr;
        gap: 20px;
      }
      .brugt-galleri {
        max-width: 440px;
      }
    }

    /* CTA nederst. */
    .brugt-cta-sektion {
      padding: 10px 0 80px;
    }
    .brugt-cta {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 30px;
      align-items: center;
      background: #fff;
      border: 1px solid rgba(29, 62, 227, 0.12);
      border-radius: 20px;
      padding: 34px;
      box-shadow: 0 18px 50px -30px rgba(29, 62, 227, 0.4);
    }
    .brugt-cta-tekst h2 {
      font-size: 1.65rem;
      margin: 0 0 12px;
    }
    .brugt-cta-tekst p {
      color: #2c2c34;
      margin: 0 0 20px;
      max-width: 46ch;
    }
    .brugt-cta-tekst p a {
      color: var(--cobalt, #1d3ee3);
      text-decoration: underline;
    }
    .brugt-knapper {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }
    .brugt-tider {
      background: rgba(29, 62, 227, 0.05);
      border-radius: 14px;
      padding: 22px 24px;
    }
    .brugt-tider h3 {
      font-size: 1.05rem;
      margin: 0 0 14px;
    }
    .brugt-tider ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .brugt-tider li {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      padding: 7px 0;
      border-bottom: 1px solid rgba(20, 20, 30, 0.08);
    }
    .brugt-tider li:last-child {
      border-bottom: 0;
    }
    .brugt-tider .dag {
      font-weight: 700;
    }
    .brugt-tider .tid {
      color: #3c3c46;
      font-variant-numeric: tabular-nums;
    }
    @media (max-width: 760px) {
      .brugt-cta {
        grid-template-columns: 1fr;
        padding: 26px;
      }
    }
  </style>
</Layout>
