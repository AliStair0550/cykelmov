---
import Layout from '../layouts/Layout.astro';
import StructuredData from '../components/StructuredData.astro';
import { site } from '../lib/site';
import { kr } from '../lib/format';
import { absUrl } from '../lib/schema';
import { hentBrugteCykler } from '../lib/data';

const brugte = await hentBrugteCykler();
const tilSalg = brugte.filter((b) => !b.solgt);

// FAQ til FAQPage-schema.
const faq = [
  {
    q: 'Køber I brugte cykler?',
    s: 'Ja. Kom forbi butikken med cyklen, så giver vi dig en faglig vurdering og en fair pris med det samme – både hvis du vil sælge, og hvis du vil bytte til en nyere cykel.',
  },
  {
    q: 'Har I altid brugte cykler til salg?',
    s: 'Ja, men udvalget skifter hver uge. Se dem her på siden, eller ring og hør, hvad vi har hjemme lige nu.',
  },
  {
    q: 'Hvordan gør I cyklerne klar?',
    s: 'Ingen cykel kommer på gulvet uden en tur gennem værkstedet. Vi tjekker bremser, gear, dæk, kæde og lås, og det der er slidt, bliver skiftet – så du får en cykel, der er klar til gaden fra dag ét.',
  },
  {
    q: 'Kan jeg prøve cyklen først?',
    s: 'Ja. Tag den en tur på Nørrebrogade, inden du beslutter dig.',
  },
  {
    q: 'Hvorfor købe brugt fra butik frem for nettet?',
    s: 'Du kan prøve cyklen, før du køber, og du taler med en mekaniker frem for en sælger på en annonce. Og du har en butik at komme tilbage til, hvis noget driller. Det har du ikke på DBA.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.s },
  })),
};

// Produkt-liste (ItemList) for de brugte cykler, så Google forstår udvalget.
const produktListe =
  brugte.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'Brugte cykler til salg hos Cykelmov',
        itemListElement: brugte.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          item: {
            '@type': 'Product',
            name: b.titel,
            ...(b.billede?.url ? { image: absUrl(b.billede.url) } : {}),
            description: b.beskrivelse || 'Brugt cykel, efterset i Cykelmovs eget værksted på Nørrebro.',
            offers: {
              '@type': 'Offer',
              price: b.pris,
              priceCurrency: 'DKK',
              availability: b.solgt ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
              url: site.url + '/brugte-cykler/',
            },
          },
        })),
      }
    : null;

const adresseKort = site.adresse.gade.replace(', st. tv.', '');
---

<Layout
  title="Brugte cykler i København"
  titelFuld="Brugte cykler København | Køb & sælg efterset cykel | Cykelmov"
  description="Brugte kvalitetscykler på Nørrebro – efterset i eget værksted og klar til gaden. Se udvalget, eller få din egen brugte cykel vurderet og købt til en fair pris. Nørrebrogade 74."
  ogBillede="/assets/brugt-cover.jpg"
  headerMoerk
>
  <StructuredData slot="head" data={faqSchema} />
  {produktListe && <StructuredData slot="head" data={produktListe} />}

  <section class="brugt-hero">
    <div class="wrap">
      <span class="eyebrow ingen-streg">Brugte cykler</span>
      <h1 class="display-l">Brugte cykler i København</h1>
    </div>
  </section>

  <!-- KØBER DIN BRUGTE CYKEL -->
  <section class="brugt-koeb-sektion">
    <div class="wrap">
      <div class="brugt-koeb reveal">
        <div class="brugt-koeb-tekst">
          <span class="eyebrow ingen-streg">Vi køber din cykel</span>
          <h2>Har du en brugt cykel, vi skal købe?</h2>
          <p>
            Kom forbi {adresseKort} med din cykel. Så gennemgår vi den og giver dig et fair tilbud på
            stedet, baseret på cyklens stand og værdi.
          </p>
          <p>
            Du kan også lade din gamle cykel indgå i en byttehandel, når du køber en nyere hos os. Vi
            trækker bytteprisen fra, så du kun betaler forskellen.
          </p>
          <p>Du er altid velkommen til at ringe først.</p>
          <div class="brugt-koeb-knapper">
            <a href={site.maps} class="btn btn-cobalt">Find vej til butikken <span class="pil">→</span></a>
            <a href={`tel:${site.telefonE164}`} class="btn btn-ghost">Ring {site.telefon}</a>
          </div>
        </div>
        <ul class="brugt-koeb-punkter">
          <li><span class="tjek">✓</span> Faglig vurdering af en mekaniker</li>
          <li><span class="tjek">✓</span> Fair pris efter cyklens stand</li>
          <li><span class="tjek">✓</span> Svar og pris med det samme</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- BRUGTE CYKLER TIL SALG -->
  <section class="brugt-salg">
    <div class="wrap">
      <div class="sektion-hoved reveal">
        <div>
          <span class="eyebrow ingen-streg">Til salg nu</span>
          <h2 class="display-l">Brugte cykler til salg</h2>
          <p class="lead" style="margin-top:12px;max-width:52ch">
            Udvalget skifter hver uge. Se, hvad vi har hjemme lige nu – eller ring og hør nærmere.
          </p>
        </div>
      </div>

      {tilSalg.length === 0 && brugte.length === 0 ? (
        <div class="brugt-tom reveal">
          <p>
            Lageret skifter hver uge, og lige nu lægger vi nye cykler op. Ring på
            <a href={`tel:${site.telefonE164}`}>{site.telefon}</a>, eller kom forbi {adresseKort} og
            se, hvad vi har hjemme.
          </p>
        </div>
      ) : (
        <div class="brugt-salg-grid">
          {brugte.map((b) => (
            <article class={`brugt-kort reveal${b.solgt ? ' er-solgt' : ''}`}>
              <div class="brugt-kort-foto">
                {b.billede?.url ? (
                  <img src={b.billede.url} alt={b.billede.alt} loading="lazy" width="700" height="525" />
                ) : (
                  <div class="intet-foto" aria-hidden="true">🚲</div>
                )}
                {b.solgt && <span class="solgt-maerke">Solgt</span>}
              </div>
              <div class="brugt-kort-tekst">
                <h3>{b.titel}</h3>
                {b.beskrivelse && <p class="brugt-kort-besk">{b.beskrivelse}</p>}
                <span class="brugt-kort-pris">{kr(b.pris)}</span>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- BREAKER: tryghed ved brugtkøb -->
  <section class="usp-baand brugt-breaker">
    <div class="wrap">
      <div class="usp-grid">
        <div class="usp reveal"><div class="tal">Efterset</div><h3>I eget værksted</h3><p>Bremser, gear, dæk, kæde og lås tjekket, inden du får cyklen.</p></div>
        <div class="usp reveal"><div class="tal">Prøvetur</div><h3>Prøv før du køber</h3><p>Tag cyklen en tur på Nørrebrogade, inden du beslutter dig.</p></div>
        <div class="usp reveal"><div class="tal">Byt</div><h3>Tag din gamle i bytte</h3><p>Vi trækker bytteprisen fra, så du kun betaler forskellen.</p></div>
        <div class="usp reveal"><div class="tal">10+ år</div><h3>Erfaren butik</h3><p>En fysisk butik at vende tilbage til, hvis noget skulle drille.</p></div>
      </div>
    </div>
  </section>

  <!-- SEO-TEKST + FAQ -->
  <section class="brugt-tekst">
    <div class="wrap">
      <article class="rig-tekst">
        <h2>Ofte stillede spørgsmål</h2>
        <div class="faq">
          {faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div class="svar">{f.s}</div>
            </details>
          ))}
        </div>
      </article>
    </div>
  </section>

  <!-- CTA nederst -->
  <section class="brugt-cta-sektion">
    <div class="wrap">
      <div class="brugt-cta reveal">
        <div class="brugt-cta-tekst">
          <h2>Kom forbi eller ring</h2>
          <p>
            Kom forbi {adresseKort} i {site.adresse.by} eller ring på
            <a href={`tel:${site.telefonE164}`}>{site.telefon}</a>. Vi finder en cykel, der passer til
            dig eller køber din gamle.
          </p>
          <div class="brugt-knapper">
            <a href={site.maps} class="btn btn-cobalt">Find vej <span class="pil">→</span></a>
            <a href={`tel:${site.telefonE164}`} class="btn btn-ghost">Ring {site.telefon}</a>
            <a href="/vaerksted/" class="btn btn-ghost">Se værkstedet</a>
          </div>
        </div>
        <div class="brugt-tider">
          <h3>Åbningstider</h3>
          <ul>
            {site.aabningstider.map((a) => (
              <li>
                <span class="dag">{a.dage}</span>
                <span class="tid">{a.tid}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Cover-hero med billede + mørk gradient, så teksten forbliver læsbar. */
    .brugt-hero {
      position: relative;
      color: var(--kridt);
      padding: 150px 0 90px;
      overflow: hidden;
      background:
        linear-gradient(90deg, rgba(16, 16, 20, 0.82), rgba(16, 16, 20, 0.4) 58%, rgba(16, 16, 20, 0.2)),
        url('/assets/brugt-cover.jpg') center 90% / cover no-repeat;
    }
    .brugt-hero .eyebrow {
      color: var(--signal);
    }
    .brugt-hero h1 {
      max-width: 18ch;
      margin-top: 14px;
    }
    @media (max-width: 700px) {
      .brugt-hero {
        padding: 120px 0 60px;
        background:
          linear-gradient(180deg, rgba(16, 16, 20, 0.55), rgba(16, 16, 20, 0.78)),
          url('/assets/brugt-cover.jpg') center 90% / cover no-repeat;
      }
    }

    /* KØB-SEKTION */
    .brugt-koeb-sektion {
      padding: 54px 0 24px;
    }
    .brugt-koeb {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 36px;
      align-items: center;
      background: #fff;
      border: 1px solid rgba(29, 62, 227, 0.12);
      border-radius: 20px;
      padding: 36px;
      box-shadow: 0 18px 50px -30px rgba(29, 62, 227, 0.4);
    }
    .brugt-koeb .eyebrow {
      color: var(--cobalt, #1d3ee3);
    }
    .brugt-koeb-tekst h2 {
      font-size: clamp(1.5rem, 3.5vw, 2.1rem);
      margin: 8px 0 14px;
    }
    .brugt-koeb-tekst p {
      color: #2c2c34;
      margin: 0 0 14px;
      max-width: 54ch;
    }
    .brugt-koeb-tekst p a {
      color: var(--cobalt, #1d3ee3);
      text-decoration: underline;
    }
    .brugt-koeb-knapper {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 20px;
    }
    .brugt-koeb-punkter {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 12px;
    }
    .brugt-koeb-punkter li {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 600;
      color: #1a1a22;
    }
    .brugt-koeb-punkter .tjek {
      flex: none;
      width: 24px;
      height: 24px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--cobalt, #1d3ee3);
      color: #fff;
      font-size: 0.8rem;
    }
    @media (max-width: 760px) {
      .brugt-koeb {
        grid-template-columns: 1fr;
        gap: 22px;
        padding: 26px;
      }
    }

    /* TIL SALG-GRID */
    .brugt-salg {
      padding: 30px 0 40px;
    }
    .brugt-salg-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 22px;
    }
    .brugt-kort {
      background: #fff;
      border: 1px solid var(--linje, rgba(20, 20, 30, 0.1));
      border-radius: 16px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .brugt-kort-foto {
      position: relative;
      aspect-ratio: 4 / 3;
      background: var(--kridt-2, #f3f3f0);
    }
    .brugt-kort-foto img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .brugt-kort-foto .intet-foto {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      font-size: 2.4rem;
      opacity: 0.4;
    }
    .solgt-maerke {
      position: absolute;
      top: 12px;
      left: 12px;
      background: #101014;
      color: #fff;
      font-weight: 800;
      font-size: 0.78rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 6px 12px;
      border-radius: 999px;
    }
    .brugt-kort.er-solgt .brugt-kort-foto img {
      filter: grayscale(0.7);
      opacity: 0.72;
    }
    .brugt-kort-tekst {
      padding: 16px 16px 18px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex: 1;
    }
    .brugt-kort-tekst h3 {
      font-size: 1.08rem;
      margin: 0;
    }
    .brugt-kort-besk {
      color: #52525b;
      font-size: 0.92rem;
      margin: 0;
    }
    .brugt-kort-pris {
      margin-top: auto;
      padding-top: 8px;
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 1.25rem;
      color: var(--cobalt, #1d3ee3);
    }
    .brugt-kort.er-solgt .brugt-kort-pris {
      color: #71717a;
      text-decoration: line-through;
    }
    .brugt-tom {
      background: rgba(29, 62, 227, 0.05);
      border-radius: 14px;
      padding: 28px 30px;
    }
    .brugt-tom p {
      margin: 0;
      max-width: 60ch;
    }
    .brugt-tom a {
      color: var(--cobalt, #1d3ee3);
      text-decoration: underline;
    }

    /* Mørkt breaker-bånd mellem galleri og FAQ — lidt strammere end standard. */
    .brugt-breaker {
      padding: 52px 0;
      margin-top: 14px;
    }

    .brugt-tekst {
      padding: 40px 0 60px;
    }

    /* CTA nederst. */
    .brugt-cta-sektion {
      padding: 10px 0 80px;
    }
    .brugt-cta {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 30px;
      align-items: center;
      background: #fff;
      border: 1px solid rgba(29, 62, 227, 0.12);
      border-radius: 20px;
      padding: 34px;
      box-shadow: 0 18px 50px -30px rgba(29, 62, 227, 0.4);
    }
    .brugt-cta-tekst h2 {
      font-size: 1.65rem;
      margin: 0 0 12px;
    }
    .brugt-cta-tekst p {
      color: #2c2c34;
      margin: 0 0 20px;
      max-width: 46ch;
    }
    .brugt-cta-tekst p a {
      color: var(--cobalt, #1d3ee3);
      text-decoration: underline;
    }
    .brugt-knapper {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }
    .brugt-tider {
      background: rgba(29, 62, 227, 0.05);
      border-radius: 14px;
      padding: 22px 24px;
    }
    .brugt-tider h3 {
      font-size: 1.05rem;
      margin: 0 0 14px;
    }
    .brugt-tider ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .brugt-tider li {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      padding: 7px 0;
      border-bottom: 1px solid rgba(20, 20, 30, 0.08);
    }
    .brugt-tider li:last-child {
      border-bottom: 0;
    }
    .brugt-tider .dag {
      font-weight: 700;
    }
    .brugt-tider .tid {
      color: #3c3c46;
      font-variant-numeric: tabular-nums;
    }
    @media (max-width: 760px) {
      .brugt-cta {
        grid-template-columns: 1fr;
        padding: 26px;
      }
    }
  </style>
</Layout>
